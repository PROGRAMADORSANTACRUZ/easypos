# Variables de entorno para el despliegue en Dokploy (docker-compose.yml).
# Configúralas en el panel de Dokploy (Environment), no en este archivo.

# Postgres: crea un servidor aparte en Dokploy (app tipo "Database" -> Postgres)
# y usa sus credenciales aquí. POS crea UNA base de datos POR restaurante
# en ese mismo servidor (nombre "pos_<slug>") cuando lo registras desde la
# app, así que esta URL es solo la base "de arranque": ahí vive el directorio
# de restaurantes (plataforma) y la conexión "por defecto" — una sola base,
# una sola variable (docker-compose.yml ya copia este mismo valor también a
# PLATFORM_DATABASE_URL, que es la que espera el código internamente).
DATABASE_URL=postgresql://pos:cambia-esta-clave@tu-host-postgres:5432/pos?schema=public

# Firma de los tokens de sesión (JWT) — obligatoria, sin default, cámbiala por
# una cadena larga y aleatoria (ej. openssl rand -hex 32).
JWT_SECRET=cambia-esta-clave-larga
JWT_EXPIRES_IN=12h

# Porcentaje de IVA aplicado en la factura.
IVA_PCT=19

# Contraseña de administrador para acciones protegidas (ej. agregar mesas).
ADMIN_PASSWORD=cambia-esta-clave

# Factus (proveedor tecnológico DIAN) — credenciales OAuth2 password grant.
# Déjalas vacías si todavía no se usa facturación electrónica.
FACTUS_BASE_URL=https://api-sandbox.factus.com.co
FACTUS_CLIENT_ID=
FACTUS_CLIENT_SECRET=
FACTUS_USER=
FACTUS_PASSWORD=
FACTUS_NUMBERING_RANGE_FACTURA=
FACTUS_NUMBERING_RANGE_NOTA_CREDITO=

# Envío de documentos a Siesa UNO EE (clientes, recibos de caja y ventas). Siesa exige la VPN de AWS, así que el
# servidor en la nube no envía: un agente (server/scripts/siesa-agente.mjs) corre en un PC con la VPN, pide los
# pendientes por /api/siesa-agente y devuelve el resultado. Las claves de Siesa viven solo en el PC del agente
# (ver server/siesa-agente.env.example).
# SIESA_AGENTE_TOKEN habilita esa API: usa una cadena larga y aleatoria (mismo valor en el agente).
# SIESA_ENVIO_DESDE es obligatorio: solo se envían documentos creados desde esa fecha (ej. 2026-11-20T15:00:00-05:00).
# SIESA_VENTAS_ACTIVO=true haría que ESTE servidor envíe directo (solo si tiene acceso a Siesa); déjalo en false.
SIESA_AGENTE_TOKEN=
SIESA_ENVIO_DESDE=
SIESA_VENTAS_ACTIVO=false
SIESA_ENVIO_INTERVALO_MIN=60
SIESA_WS_URL=https://wscarnesantacruz.siesacloud.com:8043/wsUNOEE/wsUNOEE.asmx
SIESA_WS_CONEXION=UnoEE_Carnesantacruz_Real
SIESA_WS_CIA=4
SIESA_WS_USER=
SIESA_WS_PASSWORD=

# API de consulta de Siesa (apiconsulta.grupo-santacruz.com): al guardar un cliente verifica si el documento ya
# existe como tercero y lo crea o, previa confirmación, actualiza sus datos. CONSULTA_API_KEY es el X-API-Key;
# vacío = la pantalla de Clientes no consulta Siesa.
CONSULTA_API_URL=https://apiconsulta.grupo-santacruz.com
CONSULTA_API_KEY=

# Pon en "true" SOLO en el primer despliegue (crea las tablas de las 2
# bases) — después vuelve a "false", no hace falta en cada reinicio.
RUN_DB_INIT=false

# Pon en "true" SOLO en el primer despliegue (crea el usuario admin + roles +
# menú/inventario de arranque, server/prisma/seed.js) — BORRA facturas/
# pedidos/productos existentes al re-sembrar, nunca lo dejes en "true" en
# despliegues normales.
RUN_SEED=false

# true = el cliente se crea en Siesa sin vendedor, condicion de pago ni lista de precios (requerido en la compania 5).
CONSULTA_CLIENTES_SIN_CONDICIONES=false

# Comandas de cocina: por defecto las imprime el dispositivo que toma el pedido (APK o app de escritorio dentro del local),
# porque el servidor en la nube no alcanza las impresoras (IP privadas). true = las envia el servidor (solo si corre en el local).
IMPRESION_COMANDAS_SERVIDOR=false
