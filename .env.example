# Variables de entorno para el despliegue en Dokploy (docker-compose.yml).
# Configúralas en el panel de Dokploy (Environment), no en este archivo.

# Postgres: crea un servidor aparte en Dokploy (app tipo "Database" -> Postgres)
# y usa sus credenciales aquí. EASYPOS crea UNA base de datos POR restaurante
# en ese mismo servidor (nombre "easypos_<slug>"), así que el nombre de base
# de estas 2 URLs casi no importa (DATABASE_URL es solo la conexión "por
# defecto" para requests sin restaurante resuelto; PLATFORM_DATABASE_URL SÍ
# debe apuntar a una base fija que guarda el directorio de restaurantes).
DATABASE_URL=postgresql://easypos:cambia-esta-clave@tu-host-postgres:5432/easypos?schema=public
PLATFORM_DATABASE_URL=postgresql://easypos:cambia-esta-clave@tu-host-postgres:5432/easypos_platform?schema=public

# Firma de los tokens de sesión (JWT) — obligatoria, sin default, cámbiala por
# una cadena larga y aleatoria (ej. openssl rand -hex 32).
JWT_SECRET=cambia-esta-clave-larga
JWT_EXPIRES_IN=12h

# Porcentaje de IVA aplicado en la factura.
IVA_PCT=19

# Contraseña de administrador para acciones protegidas (ej. agregar mesas).
ADMIN_PASSWORD=cambia-esta-clave

# Factus (proveedor tecnológico DIAN) — credenciales OAuth2 password grant.
# Déjalas vacías si todavía no se usa facturación electrónica.
FACTUS_BASE_URL=https://api-sandbox.factus.com.co
FACTUS_CLIENT_ID=
FACTUS_CLIENT_SECRET=
FACTUS_USER=
FACTUS_PASSWORD=
FACTUS_NUMBERING_RANGE_FACTURA=
FACTUS_NUMBERING_RANGE_NOTA_CREDITO=

# Pon en "true" SOLO en el primer despliegue (aplica el esquema de la base de
# PLATAFORMA) — después vuelve a "false", no hace falta en cada reinicio.
RUN_DB_INIT=false
