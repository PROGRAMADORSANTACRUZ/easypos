# Configuracion del agente de Siesa (server/scripts/siesa-agente.mjs). Copiar a siesa-agente.env en el PC con la VPN
# de AWS. Este archivo guarda claves: no se sube al repositorio.

# POS en la nube y token compartido (mismo valor que SIESA_AGENTE_TOKEN en Dokploy).
POS_API_URL=https://pos.grupo-santacruz.com
SIESA_AGENTE_TOKEN=
# Restaurantes (slug o id) separados por coma. Vacio = la base por defecto.
POS_TENANTS=

# Servicio web de Siesa (importacion).
SIESA_WS_URL=https://wscarnesantacruz.siesacloud.com:8043/wsUNOEE/wsUNOEE.asmx
SIESA_WS_CONEXION=UnoEE_Carnesantacruz_Real
SIESA_WS_CIA=4
SIESA_WS_USER=
SIESA_WS_PASSWORD=

# Base SQL de Siesa, solo lectura, para verificar en t350 si una factura ya existe. Opcional: sin usuario no se verifica.
SIESA_SQL_USER=
SIESA_SQL_PASSWORD=
# Ruta del certificado us-east-1-bundle.pem; vacio = se descarga de Amazon.
SIESA_SQL_CA_FILE=

# API de consulta (verifica y crea terceros en Siesa). Opcional: sin esto no se crean terceros y un cliente nuevo
# se rechaza si su tercero no existe. CONSULTA_API_KEY es el valor del encabezado X-API-Key.
CONSULTA_API_URL=https://apiconsulta.grupo-santacruz.com
CONSULTA_API_KEY=

# Minutos entre ciclos (0 = un solo ciclo y termina).
SIESA_AGENTE_INTERVALO_MIN=60
