# Conexion a la base de datos (PostgreSQL)
DATABASE_URL="postgresql://easypos:easypos@localhost:5432/easypos?schema=public"

# Puerto del servidor API
PORT=4000

# Porcentaje de impuesto aplicado en la factura (ej. 19 = 19%)
IVA_PCT=19

# Contrasena de administrador para acciones protegidas (ej. agregar mesas)
ADMIN_PASSWORD=admin123

# Factus (proveedor tecnologico DIAN) - credenciales OAuth2 password grant
FACTUS_BASE_URL=https://api-sandbox.factus.com.co
FACTUS_CLIENT_ID=
FACTUS_CLIENT_SECRET=
FACTUS_USER=
FACTUS_PASSWORD=
FACTUS_NUMBERING_RANGE_FACTURA=
FACTUS_NUMBERING_RANGE_NOTA_CREDITO=
